# окружение и кэш
.venv/
__pycache__/
*.pyc
# данные владельца: сессии, снимки, профиль браузера, логи
data/sessions/
data/shots/
data/browser-profile/
data/workspace/*
!data/workspace/.gitkeep
data/training/dataset/
data/training/run.log
data/logs/
data/*.log
data/*.err
data/state.json
data/.update-check
# локальные настройки и токен демона: в git только дефолты из config.py
data/config.local.json
data/token
# не выкладываем размышления и черновики
logs/
*.tmp
# сборки
dist/
build/
*.spec
packaging/nexus.ico
# изменяемые настройки и учебные материалы не должны делать git-копию грязной
data/config.json
data/hooks.json
data/train.json
data/training/
!data/training/.gitkeep
